# Real destiny.gg app (register at https://www.destiny.gg/profile/developer)
DGG_CLIENT_ID=
DGG_CLIENT_SECRET=
DGG_REDIRECT=http://localhost:3000/oauth
DGG_ORIGIN=https://www.destiny.gg
AUTH_SECRET=
DB_FILE_NAME=sqlite.db
# Comma-separated DGG usernames made admin on sign-in
ADMIN_USERNAMES=
MEDIA_URL=https://cdn.example.com/
CLOUDFLARE_TUNNEL_TOKEN=

# Clips and thumbnails go to Cloudflare R2 when all five are set; otherwise
# they're stored under MEDIA_DIR (/data/media in Docker) and served at /files.
# Token: an Account API token with Object Read & Write on this bucket only.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=dgg-awards-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The bucket's public custom domain (not the r2.cloudflarestorage.com endpoint).
R2_PUBLIC_URL=https://dgg-awards-media.strawwaffle.dev

# Off-site backups to Google Drive every hour (docs/migration.md), on when the
# rclone token is set. BACKUP_PASSWORD only opens the older encrypted backups.
BACKUP_PASSWORD=
# RCLONE_CONFIG_GDRIVE_TYPE=drive
# RCLONE_CONFIG_GDRIVE_SCOPE=drive.file
# RCLONE_CONFIG_GDRIVE_TOKEN='{"access_token":"…","refresh_token":"…",…}'
# BACKUP_REMOTE=gdrive:DGG Awards backups

# For local previews with the dev/dgg-oauth stand-in (compose --profile mock-auth),
# use these instead of the real app values:
# DGG_CLIENT_ID=dev-client
# DGG_CLIENT_SECRET=dev-secret
# DGG_ORIGIN=http://dgg-oauth:8789
# DGG_AUTHORIZE_ORIGIN=http://localhost:8789
